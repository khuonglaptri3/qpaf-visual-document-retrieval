# M2.2 rendered sample payloads; portable manifests and reports remain tracked.
results/m2.2/**/images/

# Generated M2.3 review demo embeds source page images; rebuild from the template.
results/m2.3/review-demo-*/index.html
results/m2.3/review-demo-*/previews/

# M2.3 source PDFs, rendered pages, raw OCR and generated browser workspaces.
results/m2.3/RUN-*/inputs/pdfs/
results/m2.3/RUN-*/remote/images150/
results/m2.3/RUN-*/remote/images300/
results/m2.3/RUN-*/remote/ocr/
results/m2.3/RUN-*/review/index.html
results/m2.3/review/index.html
results/m2.3/review/previews/

# M2.6 full OCR payloads. Portable text/hash manifests and receipts stay tracked.
results/m2.6/RUN-*/output/pages/
results/m2.6/RUN-*/output/archives/
results/m2.6/RUN-*/source_snapshot.zip

# M3.1 sealed payload copies remain local; portable manifests are committed.
/results/m3.1/**/inputs/

# M3.2 validation predictions (16 MB) stay local; the receipt keeps their SHA-256.
/results/m3.2/**/validation_predictions.json
